# Backend service binding (deployment typically provides this)
ASPNETCORE_URLS=http://0.0.0.0:3001
ASPNETCORE_ENVIRONMENT=Development

# Database connection pieces (provided by the database container in this workspace)
POSTGRES_URL=localhost
POSTGRES_PORT=5000
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

# CORS: Angular frontend origin (env-driven)
FRONTEND_ORIGIN=http://localhost:3000
